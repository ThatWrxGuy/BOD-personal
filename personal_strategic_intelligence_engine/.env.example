# Application
APP_NAME="Personal Strategic Intelligence Engine"
APP_VERSION="1.0.0"
DEBUG=false

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/strategic_board"
DATABASE_URL_SYNC="postgresql://postgres:postgres@localhost:5432/strategic_board"

# LLM Provider (openai, anthropic, or mock)
LLM_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key-here"
ANTHROPIC_API_KEY="your-anthropic-api-key-here"
DEFAULT_MODEL="gpt-4-turbo-preview"

# Scheduler
SCHEDULER_ENABLED=false

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
