# =============================================================================
# Personal Strategic Intelligence Engine - Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment.
# Sensitive values should NEVER be committed to version control.
# =============================================================================

# ===================
# Application
# ===================
APP_ENV=development
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ===================
# Security
# =============================================================================
# IMPORTANT: Change this to a strong random string in production!
SECRET_KEY=changeme-insecure-default-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENABLE_AUTH=false
# Comma-separated list of origins
CORS_ORIGINS=http://localhost:3000

# ===================
# Database
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/strategic_board
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/strategic_board

# ===================
# Redis / Workers
# =============================================================================
REDIS_URL=redis://localhost:6379/0
ENABLE_WORKERS=false
WORKER_CONCURRENCY=4

# ===================
# LLM Providers
# =============================================================================
# Default: openai, anthropic, or mock
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-opus-20240229

# ===================
# GitHub Integration
# =============================================================================
GITHUB_TOKEN=

# ===================
# OpenHands AI Agent
# =============================================================================
OPENHANDS_API_KEY=

# ===================
# Signal / Data Providers
# =============================================================================
# Alpha Vantage (market data)
ALPHAVANTAGE_API_KEY=

# Polygon (market data)
POLYGON_API_KEY=

# FRED (economic data)
FRED_API_KEY=

# ===================
# Execution Safety Controls
# =============================================================================
# IMPORTANT: Keep disabled for safe local operation!
# Set to true ONLY after configuring connectors and understanding risks.
SYSTEM_EXECUTION_ENABLED=false
MANUAL_APPROVAL_REQUIRED=true
ENABLE_KILL_SWITCH=true

# Execution limits
MAX_DAILY_ACTIONS=50
MAX_TRADE_SIZE=10000.0
MAX_TRANSFER_AMOUNT=5000.0
MAX_DAILY_FINANCIAL_EXPOSURE=25000.0
RISK_SCORE_THRESHOLD=0.7

# ===================
# Email Connector (Optional)
# =============================================================================
# Keep disabled unless you need email integration
ENABLE_EMAIL_CONNECTOR=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/google/callback
GOOGLE_EMAIL_SENDER=

# ===================
# Calendar Connector (Optional)
# =============================================================================
# Keep disabled unless you need calendar integration
ENABLE_CALENDAR_CONNECTOR=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/connectors/calendar/callback
GOOGLE_CALENDAR_ID=

# ===================
# Task Connectors (Optional)
# =============================================================================
# Todoist
ENABLE_TODOIST_CONNECTOR=false
TODOIST_API_TOKEN=

# Notion
ENABLE_NOTION_CONNECTOR=false
NOTION_API_KEY=
NOTION_DATABASE_ID=

# ===================
# Financial Connectors (Optional)
# =============================================================================
# Keep disabled unless you need financial integration!
ENABLE_FINANCIAL_CONNECTOR=false

# Schwab
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=http://localhost:8000/api/connectors/schwab/callback

# Interactive Brokers
INTERACTIVE_BROKERS_HOST=
INTERACTIVE_BROKERS_PORT=
INTERACTIVE_BROKERS_ACCOUNT_ID=

# Coinbase
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ===================
# Observability
# =============================================================================
LOG_LEVEL=INFO
ENABLE_STRUCTURED_LOGGING=true
SENTRY_DSN=

# ===================
# Debate Engine
# =============================================================================
DEBATE_MAX_ROUNDS=4
DEBATE_AGENT_TIMEOUT_SECONDS=60
DEBATE_MAX_ARGUMENT_LENGTH=5000
CONSENSUS_STRONG_THRESHOLD=0.75
CONSENSUS_MODERATE_THRESHOLD=0.50

# ===================
# Learning Layer
# =============================================================================
ENABLE_LEARNING=true
PATTERN_CONFIDENCE_THRESHOLD=0.5
MAX_WEIGHT_ADJUSTMENT_PER_CYCLE=0.1
MIN_DATA_BEFORE_RECALIBRATION=5

# ===================
# Forecasting / Simulation
# =============================================================================
DEFAULT_FORECAST_HORIZON_DAYS=90
DEFAULT_SIMULATION_RUNS=100
ENABLE_RISK_PROJECTION=true
ENABLE_GOAL_PROBABILITY_MODEL=true

# ===================
# Scheduler
# =============================================================================
SCHEDULER_ENABLED=false
